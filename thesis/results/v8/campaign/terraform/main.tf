# ============================================================
# Keys (Decision 49)
# ============================================================

# Campaign-exclusive key pair, generated by Terraform -- the private
# half lives ONLY in Terraform state (local, gitignored, scanner-checked)
# and in memory during apply/the campaign; it is never written to
# user-data or to any file this repository tracks. campaign_up.sh reads
# it from `terraform output -raw campaign_private_key` (marked
# sensitive) and copies it to the control instance over SSH, using the
# operator's OWN existing key below -- not this one.
resource "tls_private_key" "campaign" {
  algorithm = "ED25519"
}

# AWS key pairs are per-region objects even when the key material is
# identical -- one aws_key_pair per region that hosts a server or client.
resource "aws_key_pair" "campaign_sa_east_1" {
  provider   = aws.sa_east_1
  key_name   = "mockopin-pqc-campaign"
  public_key = tls_private_key.campaign.public_key_openssh
}
resource "aws_key_pair" "campaign_us_east_1" {
  provider   = aws.us_east_1
  key_name   = "mockopin-pqc-campaign"
  public_key = tls_private_key.campaign.public_key_openssh
}
resource "aws_key_pair" "campaign_ap_northeast_1" {
  provider   = aws.ap_northeast_1
  key_name   = "mockopin-pqc-campaign"
  public_key = tls_private_key.campaign.public_key_openssh
}
resource "aws_key_pair" "campaign_ca_central_1" {
  provider   = aws.ca_central_1
  key_name   = "mockopin-pqc-campaign"
  public_key = tls_private_key.campaign.public_key_openssh
}
resource "aws_key_pair" "campaign_eu_north_1" {
  provider   = aws.eu_north_1
  key_name   = "mockopin-pqc-campaign"
  public_key = tls_private_key.campaign.public_key_openssh
}
resource "aws_key_pair" "campaign_ap_southeast_1" {
  provider   = aws.ap_southeast_1
  key_name   = "mockopin-pqc-campaign"
  public_key = tls_private_key.campaign.public_key_openssh
}
resource "aws_key_pair" "campaign_ap_northeast_2" {
  provider   = aws.ap_northeast_2
  key_name   = "mockopin-pqc-campaign"
  public_key = tls_private_key.campaign.public_key_openssh
}

# The control instance uses the OPERATOR's own, already-existing
# discovery key pair -- not the campaign-exclusive one -- so the
# operator can reach it directly.
resource "aws_key_pair" "operator_sa_east_1" {
  provider   = aws.sa_east_1
  key_name   = "mockopin-pqc-campaign-operator"
  public_key = var.operator_ssh_public_key
}

# ============================================================
# VPC / subnet / AMI data sources, one block per region
# ============================================================

data "aws_vpc" "sa_east_1" {
  provider = aws.sa_east_1
  default  = true
}
data "aws_vpc" "us_east_1" {
  provider = aws.us_east_1
  default  = true
}
data "aws_vpc" "ap_northeast_1" {
  provider = aws.ap_northeast_1
  default  = true
}
data "aws_vpc" "ca_central_1" {
  provider = aws.ca_central_1
  default  = true
}
data "aws_vpc" "eu_north_1" {
  provider = aws.eu_north_1
  default  = true
}
data "aws_vpc" "ap_southeast_1" {
  provider = aws.ap_southeast_1
  default  = true
}
data "aws_vpc" "ap_northeast_2" {
  provider = aws.ap_northeast_2
  default  = true
}

# sa-east-1 needs ONE specific AZ (by AZ ID, Decision 33) shared by the
# server and the L0 client -- "same zone as the server" (Decision 41) --
# plus a generic default subnet for the control instance (AZ doesn't
# matter for control).
data "aws_subnets" "sa_east_1_az1" {
  provider = aws.sa_east_1
  filter {
    name   = "vpc-id"
    values = [data.aws_vpc.sa_east_1.id]
  }
  filter {
    name   = "availability-zone-id"
    values = ["sae1-az1"]
  }
}
data "aws_subnets" "sa_east_1_default" {
  provider = aws.sa_east_1
  filter {
    name   = "vpc-id"
    values = [data.aws_vpc.sa_east_1.id]
  }
}
data "aws_subnets" "us_east_1_default" {
  provider = aws.us_east_1
  filter {
    name   = "vpc-id"
    values = [data.aws_vpc.us_east_1.id]
  }
}
# Decision 53: us-east-1's own L0 client is co-located with its server,
# same AZ ID, same pattern as sa-east-1's (Decision 33/41) -- AZ ID
# confirmed live via `describe-availability-zones` (use1-az1).
data "aws_subnets" "us_east_1_az1" {
  provider = aws.us_east_1
  filter {
    name   = "vpc-id"
    values = [data.aws_vpc.us_east_1.id]
  }
  filter {
    name   = "availability-zone-id"
    values = ["use1-az1"]
  }
}
data "aws_subnets" "ap_northeast_1_default" {
  provider = aws.ap_northeast_1
  filter {
    name   = "vpc-id"
    values = [data.aws_vpc.ap_northeast_1.id]
  }
}
# Same pattern, ap-northeast-1 (AZ ID confirmed live: apne1-az1).
data "aws_subnets" "ap_northeast_1_az1" {
  provider = aws.ap_northeast_1
  filter {
    name   = "vpc-id"
    values = [data.aws_vpc.ap_northeast_1.id]
  }
  filter {
    name   = "availability-zone-id"
    values = ["apne1-az1"]
  }
}
data "aws_subnets" "ca_central_1_default" {
  provider = aws.ca_central_1
  filter {
    name   = "vpc-id"
    values = [data.aws_vpc.ca_central_1.id]
  }
}
data "aws_subnets" "eu_north_1_default" {
  provider = aws.eu_north_1
  filter {
    name   = "vpc-id"
    values = [data.aws_vpc.eu_north_1.id]
  }
}
data "aws_subnets" "ap_southeast_1_default" {
  provider = aws.ap_southeast_1
  filter {
    name   = "vpc-id"
    values = [data.aws_vpc.ap_southeast_1.id]
  }
}
data "aws_subnets" "ap_northeast_2_default" {
  provider = aws.ap_northeast_2
  filter {
    name   = "vpc-id"
    values = [data.aws_vpc.ap_northeast_2.id]
  }
}

# x86_64 AL2023 -- every server/client candidate instance type discussed
# so far (m7i-flex, c7i-flex, m6i, c6i) is Intel/AMD-based, not Graviton.
#
# AMI resolution (this turn): PINNED, not looked up dynamically. Until
# now this was `data "aws_ami" { most_recent = true, owners =
# ["amazon"], filter { name = "al2023-ami-*-kernel-*-x86_64" } ... }`,
# one per region -- resolved FRESH on every single `plan`/`apply`. A
# real multi-day campaign (settling + 3 windows, Decision 49) could
# silently land on a DIFFERENT AMI build on a later `apply` than the
# pilot used, if Amazon publishes a new AL2023 build in between (it
# does so roughly monthly) -- undermining the "same measured
# environment across windows" requirement the whole campaign depends
# on, and doing so completely silently (Terraform would show it as an
# ordinary, expected-looking instance replacement, not flag it as an
# environment change). Pinned instead, below, to the IDs a real,
# read-only `describe-images` query (boto3, `mockopin-pqc` profile,
# the EXACT same name/architecture/virtualization-type filter the old
# data sources used) returned on 2026-10-20 -- captured once, reused
# for the whole campaign (pilot AND full run), and recorded (with this
# same reasoning) in `v8/latency/_campaign-control/environment/` by
# `record_environment.py` at campaign start, per instance, so a later
# audit can directly compare what was PINNED against what was ACTUALLY
# running. To move to a newer AMI deliberately (a real reason: a
# security update, e.g.), re-run the same describe-images query by
# hand and update this map explicitly -- never let Terraform re-resolve
# it silently again.
locals {
  pinned_ami_x86_by_region = {
    "sa-east-1"      = "ami-0c7fb00ead73effc8" # al2023-ami-minimal-2023.12.20261016.0-kernel-6.12-x86_64
    "us-east-1"      = "ami-03a2752ac82dbfc66" # al2023-ami-minimal-2023.12.20261016.0-kernel-6.12-x86_64
    "ap-northeast-1" = "ami-07908d9183aa2e0f6" # al2023-ami-minimal-2023.12.20261016.0-kernel-6.12-x86_64
    "ca-central-1"   = "ami-073c8a97e35135677" # al2023-ami-minimal-2023.12.20261016.0-kernel-6.18-x86_64
    "eu-north-1"     = "ami-0048d119f137c7738" # al2023-ami-minimal-2023.12.20261016.0-kernel-6.12-x86_64
    "ap-southeast-1" = "ami-012634091f2034c69" # al2023-ami-minimal-2023.12.20261016.0-kernel-6.12-x86_64
    "ap-northeast-2" = "ami-01d3141f570d67f71" # al2023-ami-minimal-2023.12.20261016.0-kernel-6.18-x86_64
  }
  # arm64 for the control instance only (t4g.micro, same free-tier
  # pattern as every discovery instance in this project) -- same
  # pinning rationale, same capture date/query.
  pinned_ami_arm64_sa_east_1 = "ami-0518be3fcd9e81858" # al2023-ami-minimal-2023.12.20261016.0-kernel-6.12-arm64
}

# ============================================================
# Item 5 (this turn): which installations/clients this apply actually
# creates, derived from var.enabled_client_scenarios. The control
# instance is NOT gated by this -- it's needed regardless of which
# installations are active (it's where the orchestrator itself runs).
# ============================================================
locals {
  enabled_installations  = toset([for s in var.enabled_client_scenarios : split("@", s)[1]])
  sa_east_1_enabled      = contains(local.enabled_installations, "sa-east-1")
  us_east_1_enabled      = contains(local.enabled_installations, "us-east-1")
  ap_northeast_1_enabled = contains(local.enabled_installations, "ap-northeast-1")

  l0_sa_east_1_enabled      = contains(var.enabled_client_scenarios, "L0@sa-east-1")
  l123_enabled              = contains(var.enabled_client_scenarios, "L123@sa-east-1")
  l219_enabled              = contains(var.enabled_client_scenarios, "L219@sa-east-1")
  l325_enabled              = contains(var.enabled_client_scenarios, "L325@sa-east-1")
  l0_us_east_1_enabled      = contains(var.enabled_client_scenarios, "L0@us-east-1")
  l14_enabled               = contains(var.enabled_client_scenarios, "L14@us-east-1")
  l0_ap_northeast_1_enabled = contains(var.enabled_client_scenarios, "L0@ap-northeast-1")
  l30_enabled               = contains(var.enabled_client_scenarios, "L30@ap-northeast-1")
}

# ============================================================
# Control instance -- no AWS credential, no IAM role, outside the
# self-terminate timer, SSH from the operator's own /32 only.
# ============================================================

module "control" {
  source               = "./modules/campaign_instance"
  providers            = { aws = aws.sa_east_1 }
  name_tag             = "control"
  role                 = "control"
  instance_type        = var.control_instance_type
  ami_id               = local.pinned_ami_arm64_sa_east_1
  vpc_id               = data.aws_vpc.sa_east_1.id
  subnet_id            = data.aws_subnets.sa_east_1_default.ids[0]
  key_name             = aws_key_pair.operator_sa_east_1.key_name
  ssh_ingress_cidrs    = { "operator" = var.operator_ip_cidr }
  self_terminate_hours = 0 # exempt, Decision 49
}

