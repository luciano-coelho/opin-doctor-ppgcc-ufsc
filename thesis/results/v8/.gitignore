# Terraform local state/cache -- never committed (may contain resource IDs,
# public IPs; regenerated on every terraform init/apply anyway).
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan

# Runtime-only var files (contain the operator's public IP and SSH public
# key). Generated locally per README.md, never part of version control.
*.auto.tfvars.json
*.auto.tfvars

# SSH keys are never stored in this repo at all (see README.md) -- this
# entry is defense in depth in case one is ever copied in by mistake.
ssh/
*.pem
id_ed25519*
id_rsa*

# Python bytecode cache from running the scripts locally.
__pycache__/
*.pyc

# Real account ID / operator public IP, for scripts/scan_secrets.sh to
# check documentation against -- local-only, never committed. Docs use
# <ID_DA_CONTA>/<IP_DO_AUTOR> placeholders instead of the real values.
.scan-values.local.sh

# Decision 49: the campaign's own local vars file (real key paths) and
# the locally pulled copy of campaign data -- never committed, the
# example file (campaign.vars.example.sh) is the tracked template.
campaign.vars.local.sh
campaign-data-pulled/
