+// dualHandshakePipe runs a client and a server handshake concurrently
+// over a REAL (loopback TCP, via the existing test suite's own
+// localPipe helper) connection, returning both sides' *Conn (still open
+// -- the caller closes them) and both handshake errors. A plain
+// net.Pipe() is deliberately NOT used here: it is fully synchronous and
+// unbuffered, so if the server's first flight spans more than one
+// record and the client aborts partway through reading it (exactly
+// what several of the negative tests below do, by design), both sides
+// can end up blocked writing at once with neither reading -- a
+// transport-level deadlock, not a protocol bug. A real loopback
+// connection has OS-level socket buffering and does not have this
+// failure mode, matching how the rest of this test suite's own full
+// handshake tests are already built.
+//
+// TLS 1.3 clients return from Handshake once their OWN last flight is
+// sent, without waiting to learn whether the server accepted it (the
+// same asymmetry this project already diagnosed once in the real v8
+// probe work). If the server rejects the client's certificate AFTER
+// that point, its alert has nowhere to land unless the client keeps
+// reading -- so, when the client's own Handshake succeeded, this does
+// one more bounded Read to give a late server-side alert somewhere to
+// go, instead of leaving the server's write pending for the socket's
+// own buffer (harmless) or, in a pathological case, blocking on a full
+// buffer. A timeout with nothing to read is the expected, successful
+// case.
+func dualHandshakePipe(t testing.TB, clientConfig, serverConfig *Config) (clientConn, serverConn *Conn, clientErr, serverErr error) {
+	c, s := localPipe(t)
+	clientConn = Client(c, clientConfig)
+	serverConn = Server(s, serverConfig)
+	errCh := make(chan error, 1)
+	go func() {
+		err := clientConn.Handshake()
+		if err == nil {
+			_ = clientConn.SetReadDeadline(time.Now().Add(2 * time.Second))
+			_, readErr := clientConn.Read(make([]byte, 1))
+			if readErr != nil {
+				if ne, ok := readErr.(net.Error); !ok || !ne.Timeout() {
+					err = readErr
+				}
+			}
+			_ = clientConn.SetReadDeadline(time.Time{})
+		}
+		errCh <- err
+	}()
+	serverErr = serverConn.Handshake()
+	clientErr = <-errCh
+	return
+}
+
+const dualTestServerName = "and.test.example"
+
+// baseDualConfigs returns a client/server Config pair with ordinary,
+// mutually-trusting classical RSA chains already wired (server auth
+// only, no mTLS) -- every test below starts from this and adds Dual as
+// needed, so each test's own diff is just the AND-specific part.
+func baseDualConfigs(pki *dualTestPKI) (client, server *Config) {
+	serverClassical := pki.classicalLeaf(dualTestServerName, x509.ExtKeyUsageServerAuth, []string{dualTestServerName})
+	server = &Config{
+		Certificates: []Certificate{serverClassical},
+		MinVersion:   VersionTLS13,
+	}
+	client = &Config{
+		RootCAs:    pki.classicalRootPool,
+		ServerName: dualTestServerName,
+		MinVersion: VersionTLS13,
+	}
+	return client, server
+}
