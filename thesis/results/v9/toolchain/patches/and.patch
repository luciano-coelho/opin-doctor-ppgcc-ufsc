+func testDualTamperedSignature(t *testing.T, tamperClassical bool) {
+	classicalCert := &Certificate{PrivateKey: mustGenerateRSAKeyForTest(t)}
+	pqKey, err := mldsa.GenerateKey(mldsa.MLDSA65())
+	if err != nil {
+		t.Fatal(err)
+	}
+	pqCert := &Certificate{PrivateKey: pqKey}
+
+	signed := []byte("dual signature test transcript value")
+	sig, err := signDualMessage(rand.Reader, signed, classicalCert, pqCert)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if tamperClassical {
+		sig[2] ^= 0xFF // first byte of the classical signature itself
+	} else {
+		sig[len(sig)-1] ^= 0xFF // last byte, always inside the PQ signature
+	}
+
+	classicalPriv := classicalCert.PrivateKey.(*rsa.PrivateKey)
+	err = verifyDualMessage(signed, sig, &classicalPriv.PublicKey, pqKey.PublicKey())
+	if err == nil {
+		t.Fatal("verifyDualMessage succeeded on a tampered signature, want an error")
+	}
+}
