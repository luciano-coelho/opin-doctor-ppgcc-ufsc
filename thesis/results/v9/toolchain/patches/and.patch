+func TestDualCertificateMessageMalformedDelimiter(t *testing.T) {
+	pki := newDualTestPKI(t)
+	classical := pki.classicalLeaf(dualTestServerName, x509.ExtKeyUsageServerAuth, []string{dualTestServerName})
+	pq := pki.pqLeaf(dualTestServerName, x509.ExtKeyUsageServerAuth, []string{dualTestServerName})
+
+	entry := func(cert []byte) []byte {
+		out := []byte{0, 0, 0}
+		out[0] = byte(len(cert) >> 16)
+		out[1] = byte(len(cert) >> 8)
+		out[2] = byte(len(cert))
+		out = append(out, cert...)
+		out = append(out, 0, 0) // empty extensions
+		return out
+	}
+	delimiter := []byte{0, 0, 0} // zero-length entry, no extensions field
+
+	build := func(entries ...[]byte) []byte {
+		var certList []byte
+		for _, e := range entries {
+			certList = append(certList, e...)
+		}
+		listLen := len(certList)
+		body := []byte{0} // certificate_request_context
+		body = append(body, byte(listLen>>16), byte(listLen>>8), byte(listLen))
+		body = append(body, certList...)
+		msg := []byte{typeCertificate}
+		msg = append(msg, byte(len(body)>>16), byte(len(body)>>8), byte(len(body)))
+		msg = append(msg, body...)
+		return msg
+	}
+
+	classicalEntry := entry(classical.Certificate[0])
+	pqEntry := entry(pq.Certificate[0])
+
+	cases := []struct {
+		name string
+		data []byte
+		want bool
+	}{
+		{"valid single delimiter", build(classicalEntry, delimiter, pqEntry), true},
+		{"delimiter first", build(delimiter, classicalEntry, pqEntry), false},
+		{"delimiter last", build(classicalEntry, pqEntry, delimiter), false},
+		{"delimiter repeated", build(classicalEntry, delimiter, pqEntry, delimiter), false},
+		{"no delimiter (ordinary message)", build(classicalEntry, pqEntry), true},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			m := new(certificateMsgTLS13)
+			got := m.unmarshal(c.data)
+			if got != c.want {
+				t.Errorf("unmarshal = %v, want %v", got, c.want)
+			}
+		})
+	}
+}
