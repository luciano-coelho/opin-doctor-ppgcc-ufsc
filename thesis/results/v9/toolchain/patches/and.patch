+// --- Decision 39 (independent review of HEAD 23ee2ceb): a strict peer
+// must actually ENFORCE dual authentication, not just negotiate it.
+// The two tests below use testingOnlyForceSingleChainCertificateVerify
+// to make an otherwise dual-CAPABLE peer sign CertificateVerify with
+// its classical algorithm alone -- simulating a non-compliant (or
+// malicious) implementation that advertises/accepts the dual codepoint
+// but does not actually use it -- and confirm the STRICT side on the
+// other end refuses the connection instead of silently accepting it as
+// classically (non-dual) authenticated. ---
+
+func TestDualStrictClientRejectsServerThatIgnoresTheOffer(t *testing.T) {
+	pki := newDualTestPKI(t)
+	client, server := baseDualConfigs(pki)
+
+	serverPQ := pki.pqLeaf(dualTestServerName, x509.ExtKeyUsageServerAuth, []string{dualTestServerName})
+	// The server is dual-CAPABLE (has a real, valid post-quantum chain
+	// configured) but NOT itself strict -- Require is false here on
+	// purpose, since the point under test is that it chooses not to
+	// use the dual codepoint even though it could, not that it was
+	// ever told dual was optional for IT.
+	server.Dual = &DualConfig{Certificates: []Certificate{serverPQ}}
+	// The client is strict: dual authentication of the SERVER is
+	// mandatory.
+	client.Dual = &DualConfig{RootCAs: pki.pqRootPool, Require: true}
+
+	testingOnlyForceSingleChainCertificateVerify = true
+	defer func() { testingOnlyForceSingleChainCertificateVerify = false }()
+
+	cc, sc, cerr, serr := dualHandshakePipe(t, client, server)
+	defer cc.Close()
+	defer sc.Close()
+	if cerr == nil {
+		t.Fatalf("client: expected handshake failure (server signed CertificateVerify classically despite client.Dual.Require=true), got success (server error: %v)", serr)
+	}
+	if cs := cc.ConnectionState(); cs.DualAuthenticated {
+		t.Error("client: DualAuthenticated = true on a connection that should have failed outright")
+	}
+}
