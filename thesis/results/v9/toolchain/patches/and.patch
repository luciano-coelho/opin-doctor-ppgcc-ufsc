+// --- HelloRetryRequest with the project's own hybrid group
+// (SecP384r1MLKEM1024): curvePreferences() (common.go) always sorts
+// whatever groups Config.CurvePreferences allows into one FIXED global
+// order (every hybrid/PQ group before every classical one, per
+// curvePreferenceOrder in defaults.go) regardless of the order they're
+// listed in -- so a client's INITIAL key share is always generated for
+// the single highest group in that fixed order it allows, never
+// whichever one is listed first in Config.CurvePreferences. To force a
+// real retry onto SecP384r1MLKEM1024 specifically, the client must
+// also allow a group that sorts EARLIER in that fixed order
+// (X25519MLKEM768) -- its initial share goes out for that group, the
+// server (which only accepts SecP384r1MLKEM1024) can't use it, and
+// replies with a HelloRetryRequest naming SecP384r1MLKEM1024, which
+// the client already declared support for and now sends a share for.
+// The dual handshake must still complete correctly across that extra
+// round trip.
+func TestDualHandshakeAcrossHelloRetryRequest(t *testing.T) {
+	pki := newDualTestPKI(t)
+	client, server := baseDualConfigs(pki)
+	// initialShareGroup: what the FIRST ClientHello's key share is for
+	// (X25519MLKEM768 sorts first in curvePreferenceOrder, so it gets
+	// the client's initial share even though SecP384r1MLKEM1024 is
+	// also allowed).
+	initialShareGroup := X25519MLKEM768
+	// retryTargetGroup: the only group the server accepts -- it cannot
+	// use the client's initial share, so it must send a
+	// HelloRetryRequest naming this group specifically, which the
+	// client already declared support for (just without an initial
+	// share) and now sends a fresh share for.
+	retryTargetGroup := SecP384r1MLKEM1024
+	server.CurvePreferences = []CurveID{retryTargetGroup}
+	client.CurvePreferences = []CurveID{initialShareGroup, retryTargetGroup}
+
+	// Full mutual (mTLS) dual auth, not just the server's own identity
+	// -- so BOTH sides' own DualAuthenticated is legitimately expected
+	// to be true, and the retry is exercised against the more complex
+	// path the real Hibrido-AND profile actually uses.
+	serverPQ := pki.pqLeaf(dualTestServerName, x509.ExtKeyUsageServerAuth, []string{dualTestServerName})
+	server.Dual = &DualConfig{Certificates: []Certificate{serverPQ}, Require: true}
+	client.Dual = &DualConfig{RootCAs: pki.pqRootPool, Require: true}
+	clientClassical := pki.classicalLeaf("and-client", x509.ExtKeyUsageClientAuth, nil)
+	clientPQ := pki.pqLeaf("and-client", x509.ExtKeyUsageClientAuth, nil)
+	client.Certificates = []Certificate{clientClassical}
+	client.Dual.Certificates = []Certificate{clientPQ}
+	server.ClientAuth = RequireAndVerifyClientCert
+	server.ClientCAs = pki.classicalRootPool
+	server.Dual.ClientCAs = pki.pqRootPool
+
+	cc, sc, cerr, serr := dualHandshakePipe(t, client, server)
+	defer cc.Close()
+	defer sc.Close()
+	if cerr != nil || serr != nil {
+		t.Fatalf("dual handshake across a HelloRetryRequest failed: client=%v server=%v", cerr, serr)
+	}
+	cs, ss := cc.ConnectionState(), sc.ConnectionState()
+	t.Logf("first ClientHello key share: %v; server's only accepted group (HelloRetryRequest target): %v; negotiated group after retry: client=%v server=%v",
+		initialShareGroup, retryTargetGroup, cs.CurveID, ss.CurveID)
+	if !cs.HelloRetryRequest || !ss.HelloRetryRequest {
+		t.Fatalf("test setup error: no HelloRetryRequest actually happened (client.HelloRetryRequest=%v server.HelloRetryRequest=%v), so this didn't test what it claims to", cs.HelloRetryRequest, ss.HelloRetryRequest)
+	}
+	if !cs.DualAuthenticated || !ss.DualAuthenticated {
+		t.Errorf("DualAuthenticated = false after a MUTUAL dual handshake that completed across a HelloRetryRequest (client=%v server=%v) -- both sides presented and verified a dual pair, both should report true", cs.DualAuthenticated, ss.DualAuthenticated)
+	}
+	if cs.CurveID != retryTargetGroup || ss.CurveID != retryTargetGroup {
+		t.Errorf("negotiated group = client:%v server:%v, want %v (the group the HelloRetryRequest asked for) on both sides", cs.CurveID, ss.CurveID, retryTargetGroup)
+	}
+}
