+// TestSameDualIdentitySANFallback is a direct unit test of
+// sameDualIdentity itself (no handshake involved), proving the exact
+// boundary the independent review of HEAD 23ee2ceb asked to confirm
+// (Decision 45): the CommonName fallback fires ONLY when NEITHER leaf
+// carries any SAN -- never when just one of the two lacks a SAN. If
+// the fallback fired on that asymmetric case too, a certificate with
+// NO SAN could be paired with an unrelated one that DOES have a SAN,
+// as long as the CommonNames happened to match -- defeating the SAN
+// check's own purpose for every certificate that still carries one.
+func TestSameDualIdentitySANFallback(t *testing.T) {
+	pki := newDualTestPKI(t)
+	parse := func(c Certificate) *x509.Certificate {
+		leaf, err := x509.ParseCertificate(c.Certificate[0])
+		if err != nil {
+			t.Fatalf("parse leaf: %v", err)
+		}
+		return leaf
+	}
+
+	bothSANlessSameCN := parse(pki.classicalLeaf("same-cn", x509.ExtKeyUsageClientAuth, nil))
+	bothSANlessSameCNOther := parse(pki.pqLeaf("same-cn", x509.ExtKeyUsageClientAuth, nil))
+	if !sameDualIdentity(bothSANlessSameCN, bothSANlessSameCNOther) {
+		t.Error("both SAN-less, same CommonName: expected match (the fallback case this project's own SAN-less client certs rely on), got no match")
+	}
+
+	bothSANlessDiffCN := parse(pki.classicalLeaf("cn-a", x509.ExtKeyUsageClientAuth, nil))
+	bothSANlessDiffCNOther := parse(pki.pqLeaf("cn-b", x509.ExtKeyUsageClientAuth, nil))
+	if sameDualIdentity(bothSANlessDiffCN, bothSANlessDiffCNOther) {
+		t.Error("both SAN-less, different CommonName: expected no match (unrelated pair), got a match")
+	}
+
+	// The asymmetric case: ONE leaf has a real SAN, the other has
+	// none, but both happen to share the same CommonName. The
+	// fallback's own guard (!leafHasAnySAN(a) && !leafHasAnySAN(b))
+	// must NOT trigger here -- this must fall through to the ordinary
+	// SAN-set comparison, which correctly reports no match (an empty
+	// SAN set is never equal to a non-empty one).
+	oneSANSameCN := parse(pki.classicalLeaf("same-cn-2", x509.ExtKeyUsageClientAuth, []string{"example.test"}))
+	otherSANlessSameCN := parse(pki.pqLeaf("same-cn-2", x509.ExtKeyUsageClientAuth, nil))
+	if sameDualIdentity(oneSANSameCN, otherSANlessSameCN) {
+		t.Error("one leaf has a SAN, the other has none, same CommonName: expected no match (fallback must not apply when only one leaf is SAN-less), got a match")
+	}
+	if sameDualIdentity(otherSANlessSameCN, oneSANSameCN) {
+		t.Error("same asymmetric case, arguments swapped: expected no match, got a match")
+	}
+
+	// Sanity: both leaves WITH the same SAN -- the ordinary path (not
+	// the fallback), which is the real shape of every one of this
+	// project's own 4 profiles' server certificates (classico/pqc/
+	// hibrido-v8/hibrido-and all set a non-empty SAN on every leaf --
+	// confirmed separately against certs/main.go, Decision 45).
+	bothSameSAN := parse(pki.classicalLeaf("irrelevant-cn-1", x509.ExtKeyUsageServerAuth, []string{"mtls"}))
