+// --- 13/14: the quantum adversary that motivates the whole mechanism.
+// An attacker who has stolen only the RSA private key of a legitimate
+// dual pair (the certificates themselves are always public) can
+// authenticate against a Hybrid-v8-style, classical-only verifier, but
+// not against a real dual (AND) verifier -- because they cannot
+// produce the pair's own ML-DSA signature. ---
+
+func TestDualQuantumAdversaryHoldingOnlyRSAKey(t *testing.T) {
+	pki := newDualTestPKI(t)
+	client, server := baseDualConfigs(pki)
+
+	serverPQ := pki.pqLeaf(dualTestServerName, x509.ExtKeyUsageServerAuth, []string{dualTestServerName})
+	server.Dual = &DualConfig{Certificates: []Certificate{serverPQ}, Require: true}
+
+	clientClassical := pki.classicalLeaf("and-client", x509.ExtKeyUsageClientAuth, nil)
+	// The adversary presents the PAIR's real, legitimately-issued
+	// public PQ certificate (observable on any prior wire capture --
+	// there is no secrecy in a certificate), but signs with a FRESH,
+	// unrelated key: exactly what holding the RSA private key but not
+	// the ML-DSA one looks like on the wire.
+	legitPQKey, err := mldsa.GenerateKey(mldsa.MLDSA65())
+	if err != nil {
+		t.Fatal(err)
+	}
+	adversaryKey, err := mldsa.GenerateKey(mldsa.MLDSA65())
+	if err != nil {
+		t.Fatal(err)
+	}
+	adversaryPQCert := pki.pqLeafWithKey("and-client", x509.ExtKeyUsageClientAuth, nil,
+		legitPQKey.PublicKey(), adversaryKey)
+
+	client.Certificates = []Certificate{clientClassical}
+	client.Dual = &DualConfig{Certificates: []Certificate{adversaryPQCert}, RootCAs: pki.pqRootPool, Require: true}
+	server.ClientAuth = RequireAndVerifyClientCert
+	server.ClientCAs = pki.classicalRootPool
+	server.Dual.ClientCAs = pki.pqRootPool
+
+	cc, sc, cerr, serr := dualHandshakePipe(t, client, server)
+	defer cc.Close()
+	defer sc.Close()
+	if serr == nil {
+		t.Fatalf("quantum adversary (RSA key only) authenticated against a strict dual server -- classical ok, post-quantum should have failed; client=%v server=%v", cerr, serr)
+	}
+}
