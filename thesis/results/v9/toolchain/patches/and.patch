+// --- Decision 39: a classical/post-quantum pair that BOTH carry no
+// Subject Alternative Name at all must not be accepted as "the same
+// identity" under Require=true -- two empty SAN sets are trivially
+// equal to each other, which is not evidence of anything. ---
+
+func TestDualClientSANlessIdentityRejectedWhenRequired(t *testing.T) {
+	pki := newDualTestPKI(t)
+	client, server := baseDualConfigs(pki)
+
+	// Both leaves deliberately carry NO SAN of any kind (nil dnsNames,
+	// and dualTestPKI's own leaf helpers never set EmailAddresses/
+	// IPAddresses/URIs) -- sameDualIdentity's set comparison alone
+	// would call this a match (two empty sets), which is exactly the
+	// vacuous-match bug. Decision 39's actual fix falls back to
+	// comparing Subject.CommonName in exactly this SAN-less case
+	// (needed because this project's OWN legitimate client
+	// certificates are routinely SAN-less, identified by CommonName
+	// instead -- TestDualStrictFullMTLS, elsewhere in this file, is
+	// exactly that pattern and must keep passing) -- so this test
+	// gives the two leaves DIFFERENT CommonNames, simulating an
+	// adversary pairing two unrelated, equally SAN-less certificates,
+	// which the CommonName fallback must still correctly reject.
+	clientClassical := pki.classicalLeaf("and-client-classical", x509.ExtKeyUsageClientAuth, nil)
+	clientPQ := pki.pqLeaf("and-client-UNRELATED-pq", x509.ExtKeyUsageClientAuth, nil)
+	client.Certificates = []Certificate{clientClassical}
+	client.Dual = &DualConfig{RootCAs: pki.pqRootPool, Certificates: []Certificate{clientPQ}}
+	server.ClientAuth = RequireAndVerifyClientCert
+	server.ClientCAs = pki.classicalRootPool
+	serverPQ := pki.pqLeaf(dualTestServerName, x509.ExtKeyUsageServerAuth, []string{dualTestServerName})
+	server.Dual = &DualConfig{Certificates: []Certificate{serverPQ}, ClientCAs: pki.pqRootPool, Require: true}
+
+	cc, sc, cerr, serr := dualHandshakePipe(t, client, server)
+	defer cc.Close()
+	defer sc.Close()
+	if serr == nil {
+		t.Fatalf("server: expected rejection (client's classical and post-quantum certificates are both SAN-less AND have different CommonNames -- an unrelated pair), got success (client error: %v)", cerr)
+	}
+}
