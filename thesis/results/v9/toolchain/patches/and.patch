+// --- 16: wire round-trip, both the dual and the ordinary shape. ---
+
+func TestDualCertificateMessageRoundTrip(t *testing.T) {
+	pki := newDualTestPKI(t)
+	classical := pki.classicalLeaf(dualTestServerName, x509.ExtKeyUsageServerAuth, []string{dualTestServerName})
+	pq := pki.pqLeaf(dualTestServerName, x509.ExtKeyUsageServerAuth, []string{dualTestServerName})
+
+	orig := &certificateMsgTLS13{
+		certificate:       classical,
+		dualPQCertificate: pq.Certificate,
+	}
+	data, err := orig.marshal()
+	if err != nil {
+		t.Fatal(err)
+	}
+	got := new(certificateMsgTLS13)
+	if !got.unmarshal(data) {
+		t.Fatal("unmarshal of a well-formed dual Certificate message returned false")
+	}
+	if len(got.certificate.Certificate) != len(classical.Certificate) ||
+		string(got.certificate.Certificate[0]) != string(classical.Certificate[0]) {
+		t.Error("classical chain did not round-trip")
+	}
+	if len(got.dualPQCertificate) != len(pq.Certificate) ||
+		string(got.dualPQCertificate[0]) != string(pq.Certificate[0]) {
+		t.Error("post-quantum chain did not round-trip")
+	}
+
+	// The non-dual shape must still work exactly as before.
+	plain := &certificateMsgTLS13{certificate: classical}
+	data2, err := plain.marshal()
+	if err != nil {
+		t.Fatal(err)
+	}
+	got2 := new(certificateMsgTLS13)
+	if !got2.unmarshal(data2) {
+		t.Fatal("unmarshal of an ordinary, non-dual Certificate message returned false")
+	}
+	if len(got2.dualPQCertificate) != 0 {
+		t.Error("a non-dual message was parsed as if it had a post-quantum chain")
+	}
+}
