index 0000000..a7034ef
--- /dev/null
+++ b/dual.go
@@ -0,0 +1,364 @@
+// Copyright 2026 The MockOPIN project. Not part of the Go standard
+// library; a minimal, local fork of crypto/tls for the OPIN
+// post-quantum migration thesis (v9).
+//
+// AND: dual-certificate TLS 1.3 authentication. Classical (RSA-PSS-
+// SHA256) and post-quantum (ML-DSA-65) signatures are produced
+// independently, over the SAME CertificateVerify value and under the
+// SAME TLS 1.3 signature context as an ordinary single signature, and
+// are verified independently, without short-circuiting, against two
+// separately validated certificate chains. Both must be valid for the
+// connection to be dual-authenticated; neither chain substitutes for
+// the other, and neither verification is skipped because the other
+// already succeeded or failed.
+//
+// Private-use codepoint 0xFE65 stands for the pair itself, never for
+// either algorithm alone. draft-yusef-tls-pqt-dual-certs-03 (an
+// individual draft, never adopted, expires January 2027) only defines
+// ECDSA-paired codepoints; 0xFE00-0xFFFF is IANA-reserved for private
+// use, so this fork picks one value from that range for the one pair
+// this project needs.
+//
+// Session resumption, decided and tested (TestDualStrictModeDisablesSessionTickets,
+// TestDualResumedSessionDoesNotCarryDualAuthentication in dual_test.go),
+// not left as an open gap: TLS 1.3 resumption skips Certificate/
+// CertificateVerify entirely, so a resumed connection would otherwise
+// inherit dual authentication from the original handshake without
+// re-verifying either chain. Strict (Require=true) connections never
+// issue a session ticket at all (shouldSendSessionTickets,
+// handshake_server_tls13.go) -- there is nothing to resume into.
+// Non-strict connections keep issuing tickets as before; a resumed
+// connection's own ConnectionState.DualAuthenticated is always false
+// regardless of the original session's own value (never restored from
+// session state, unlike the classical PeerCertificates/VerifiedChains,
+// which Go's own existing code already does carry over) -- the dual
+// guarantee specifically does not survive resumption, and the API
+// reports that honestly rather than silently implying otherwise.
+//
+// HelloRetryRequest with the project's own hybrid group
+// (SecP384r1MLKEM1024) is tested (TestDualHandshakeAcrossHelloRetryRequest)
+// and completes correctly.
+//
+// Known gaps, still deliberately out of scope for this fork
+// (documented, not hidden): no CompressedCertificate (RFC 8879) or
+// Exported Authenticators (RFC 9261) support; no RelatedCertificate
+// (RFC 9440); no explicit rejection of the dual codepoint under TLS
+// 1.2 -- it is simply never offered or accepted below TLS 1.3, which
+// has the same practical effect without a dedicated check; the
+// client's VerifyConnection/VerifyPeerCertificate callbacks still only
+// ever see the classical chain (c.peerCertificates), exactly as
+// upstream, so they run before the post-quantum chain is validated.
+package tls
+
+import (
+	"crypto"
+	"crypto/mldsa"
+	"crypto/rsa"
+	"crypto/x509"
+	"errors"
+	"fmt"
+	"io"
+	"slices"
+	"time"
+)
+
+// dualSignatureScheme is the AND mechanism's private-use SignatureScheme
+// codepoint. It is never passed to typeAndHashFromSignatureScheme or any
+// other single-key signing/verification path -- it always denotes the
+// (RSA-PSS-SHA256, ML-DSA-65) pair, handled entirely by the functions in
+// this file.
+const dualSignatureScheme SignatureScheme = 0xFE65
+
+// testingOnlyForceSingleChainCertificateVerify, set only in tests (see
+// dual_test.go), makes this side sign CertificateVerify with its
+// classical algorithm ALONE -- a single RSA-PSS-SHA256 signature over
+// a single classical chain, no post-quantum chain sent at all -- even
+// when dual authentication was otherwise negotiated (the peer offered
+// 0xFE65 and this side has Dual configured). It bypasses the normal
+// signature-algorithm negotiation entirely (which would otherwise fail
+// outright against a strict peer that only offers 0xFE65, masking the
+// actual property under test) by hardcoding PSSWithSHA256
+// directly, simulating a non-compliant or malicious implementation that
+// advertises/accepts the dual codepoint but does not actually use it.
+// Exists to prove that a strict (Dual.Require=true) peer on the OTHER
+// side refuses such a connection instead of silently accepting it as
+// classically (non-dual) authenticated.
+var testingOnlyForceSingleChainCertificateVerify bool
+
+// DualConfig enables AND dual-certificate TLS 1.3 authentication
+// alongside -- never instead of -- the classical chain already
+// configured via Config.Certificates/GetCertificate (server side) or
+// Config.Certificates/GetClientCertificate (client side).
+type DualConfig struct {
+	// Certificates holds this side's own post-quantum (ML-DSA-65)
+	// certificate chain and private key, presented ALONGSIDE the
+	// classical chain. Only Certificates[0] is used; present to match
+	// the shape (and future extensibility) of Config.Certificates.
+	Certificates []Certificate
+
+	// RootCAs and ClientCAs are the trust anchors for the PEER's
+	// post-quantum chain. They are independent pools from Config.RootCAs/
+	// Config.ClientCAs, which remain the classical chain's own trust
+	// anchors -- the two chains are validated independently, each
+	// against its own pool, never against the other's.
+	RootCAs   *x509.CertPool
+	ClientCAs *x509.CertPool
+
+	// Require makes dual authentication mandatory for this side of the
+	// connection. In strict mode (Require true), ONLY the dual
+	// codepoint is offered/accepted -- no classical-only fallback --
+	// so a peer without dual support fails the handshake with
+	// handshake_failure, through the ordinary, unmodified
+	// selectSignatureScheme path (it finds no signature algorithm in
+	// common and returns an error; no fork-specific code is needed for
+	// that failure mode). When Require is false, the dual codepoint is
+	// offered/accepted ALONGSIDE the classical ones, and a peer
+	// without dual support is still authenticated classically --
+	// ConnectionState.DualAuthenticated reports false for that
+	// connection, so the downgrade is always observable, never silent.
+	Require bool
+}
+
+func (d *DualConfig) clone() *DualConfig {
+	if d == nil {
+		return nil
+	}
+	return &DualConfig{
+		Certificates: slices.Clone(d.Certificates),
+		RootCAs:      d.RootCAs,
+		ClientCAs:    d.ClientCAs,
+		Require:      d.Require,
+	}
+}
+
+// marshalDualSignature builds a dual CertificateVerify's signature
+// field: uint16(len(classicalSig)) || classicalSig || pqSig. pqSig's own
+// length is implicit (whatever remains), since ML-DSA-65 signatures
+// have one fixed length and there is nothing to follow them.
+func marshalDualSignature(classicalSig, pqSig []byte) []byte {
+	out := make([]byte, 2+len(classicalSig)+len(pqSig))
+	out[0] = byte(len(classicalSig) >> 8)
+	out[1] = byte(len(classicalSig))
+	copy(out[2:], classicalSig)
+	copy(out[2+len(classicalSig):], pqSig)
+	return out
+}
+
+func unmarshalDualSignature(sig []byte) (classicalSig, pqSig []byte, err error) {
+	if len(sig) < 2 {
+		return nil, nil, errors.New("tls: dual: signature field too short")
+	}
+	n := int(sig[0])<<8 | int(sig[1])
+	if n <= 0 || 2+n >= len(sig) {
+		return nil, nil, errors.New("tls: dual: invalid classical-signature length prefix")
+	}
+	return sig[2 : 2+n], sig[2+n:], nil
+}
+
+// signDualMessage produces a dual CertificateVerify signature: the
+// classical certificate's own key signs with RSA-PSS-SHA256, the
+// post-quantum certificate's own ML-DSA-65 key signs separately, BOTH
+// over the identical `signed` bytes -- signedMessage(context,
+// transcript), computed exactly once by the caller and passed to both
+// signing operations, never recomputed or varied between them.
+func signDualMessage(rand io.Reader, signed []byte, classicalCert, pqCert *Certificate) ([]byte, error) {
+	classicalSigner, ok := classicalCert.PrivateKey.(crypto.Signer)
+	if !ok {
+		return nil, errors.New("tls: dual: classical certificate's private key does not implement crypto.Signer")
+	}
+	classicalSig, err := crypto.SignMessage(classicalSigner, rand, signed,
+		&rsa.PSSOptions{SaltLength: rsa.PSSSaltLengthEqualsHash, Hash: crypto.SHA256})
+	if err != nil {
+		return nil, fmt.Errorf("tls: dual: classical signature failed: %w", err)
+	}
+
+	pqSigner, ok := pqCert.PrivateKey.(crypto.Signer)
+	if !ok {
+		return nil, errors.New("tls: dual: post-quantum certificate's private key does not implement crypto.Signer")
+	}
+	pqSig, err := crypto.SignMessage(pqSigner, rand, signed, crypto.SignerOpts(directSigning))
+	if err != nil {
+		return nil, fmt.Errorf("tls: dual: post-quantum signature failed: %w", err)
+	}
+
+	return marshalDualSignature(classicalSig, pqSig), nil
+}
+
+// verifyDualMessage checks BOTH halves of a dual CertificateVerify
+// signature. Both verifications always run, in full, regardless of
+// whether the first one already failed -- there is no early return
+// between them -- so which half failed first is never observable from
+// control flow or timing. Either half failing fails the whole dual
+// authentication, with decrypt_error, the same alert an ordinary single
+// bad signature would produce.
+func verifyDualMessage(signed, sig []byte, classicalPub, pqPub crypto.PublicKey) error {
+	classicalSig, pqSig, err := unmarshalDualSignature(sig)
+	if err != nil {
+		return err
+	}
+
+	classicalErr := verifyHandshakeSignature(signatureRSAPSS, classicalPub, crypto.SHA256, signed, classicalSig)
+	pqErr := verifyHandshakeSignature(signatureMLDSA, pqPub, directSigning, signed, pqSig)
+
+	if classicalErr != nil || pqErr != nil {
+		return fmt.Errorf("tls: dual: signature verification failed (classical: %v, post-quantum: %v)", classicalErr, pqErr)
+	}
+	return nil
+}
+
+// verifyDualPeerChain independently validates the peer's post-quantum
+// certificate chain: parses every certificate, confirms the chain is
+// genuinely post-quantum-only (no classical signature algorithm
+// anywhere in it, and the leaf's own public key is specifically
+// ML-DSA-65, never ML-DSA-44 or -87), and verifies it against pool --
+// its own trust root, never the classical chain's -- with the given
+// EKU and, when serverName is non-empty, the given hostname. It never
+// consults the classical chain's own verification result; the two
+// chains are validated as if the other did not exist.
+func verifyDualPeerChain(rawCerts [][]byte, pool *x509.CertPool, serverName string, keyUsage x509.ExtKeyUsage, now time.Time) (certs []*x509.Certificate, verifiedChain []*x509.Certificate, err error) {
+	if len(rawCerts) == 0 {
+		return nil, nil, errors.New("tls: dual: peer's post-quantum certificate chain is empty")
+	}
+	certs = make([]*x509.Certificate, len(rawCerts))
+	for i, raw := range rawCerts {
+		cert, err := x509.ParseCertificate(raw)
+		if err != nil {
+			return nil, nil, fmt.Errorf("tls: dual: failed to parse post-quantum certificate: %w", err)
+		}
+		certs[i] = cert
+	}
+
+	for _, cert := range certs {
+		if cert.PublicKeyAlgorithm != x509.MLDSA {
+			return nil, nil, fmt.Errorf("tls: dual: post-quantum chain contains a non-ML-DSA certificate (%v)", cert.PublicKeyAlgorithm)
+		}
+	}
+	leaf := certs[0]
+	pqPub, ok := leaf.PublicKey.(*mldsa.PublicKey)
+	if !ok {
+		return nil, nil, fmt.Errorf("tls: dual: post-quantum leaf's public key is %T, not ML-DSA", leaf.PublicKey)
+	}
+	if pqPub.Parameters() != mldsa.MLDSA65() {
+		return nil, nil, errors.New("tls: dual: post-quantum leaf is not ML-DSA-65")
+	}
+
+	opts := x509.VerifyOptions{
+		Roots:         pool,
+		CurrentTime:   now,
+		Intermediates: x509.NewCertPool(),
+		KeyUsages:     []x509.ExtKeyUsage{keyUsage},
+		DNSName:       serverName,
+	}
+	for _, cert := range certs[1:] {
+		opts.Intermediates.AddCert(cert)
+	}
+	chains, err := leaf.Verify(opts)
+	if err != nil {
+		return nil, nil, fmt.Errorf("tls: dual: post-quantum chain verification failed: %w", err)
+	}
+	allowed, err := fipsAllowedChains(chains)
+	if err != nil {
+		return nil, nil, fmt.Errorf("tls: dual: post-quantum chain verification failed: %w", err)
+	}
+	if len(allowed) > 0 {
+		verifiedChain = allowed[0]
+	}
+	return certs, verifiedChain, nil
+}
+
+// verifyClassicalHalfIsClassical rejects a classical chain that is not
+// actually classical: every certificate in it must use a classical
+// signature algorithm (never ML-DSA), and the leaf's own public key
+// must be RSA. Dual authentication's security property (break both, not
+// either) depends on the two halves genuinely being different
+// algorithm families, not on their names alone.
+func verifyClassicalHalfIsClassical(classicalLeaf *x509.Certificate, classicalChain []*x509.Certificate) error {
+	if _, ok := classicalLeaf.PublicKey.(*rsa.PublicKey); !ok {
+		return fmt.Errorf("tls: dual: classical leaf's public key is %T, not RSA", classicalLeaf.PublicKey)
+	}
+	for _, cert := range classicalChain {
+		switch cert.SignatureAlgorithm {
+		case x509.MLDSA44, x509.MLDSA65, x509.MLDSA87:
+			return errors.New("tls: dual: classical chain contains an ML-DSA signature")
+		}
+	}
+	return nil
+}
+
+// leafHasAnySAN reports whether leaf carries at least one Subject
+// Alternative Name entry (DNS, email, IP, or URI).
+func leafHasAnySAN(leaf *x509.Certificate) bool {
+	return len(leaf.DNSNames) > 0 || len(leaf.EmailAddresses) > 0 || len(leaf.IPAddresses) > 0 || len(leaf.URIs) > 0
+}
+
+// sameDualIdentity reports whether a client's classical and
+// post-quantum leaf certificates identify the SAME pair, by comparing
+// their Subject Alternative Name sets (DNS names, email addresses, IP
+// addresses, and URIs) as sets, order-independent. This stops an
+// adversary from pairing a legitimately-issued classical certificate
+// with an unrelated post-quantum certificate (or vice versa) to pass
+// dual authentication as someone else.
+//
+// Decision 39 (real bug, found in independent review of HEAD
+// 23ee2ceb, and the first fix for it found live, the hard way: an
+// unconditional "require SAN under Require=true" broke this project's
+// OWN existing, passing TestDualStrictFullMTLS, whose client
+// certificates are deliberately SAN-less by this project's own
+// convention -- client certificates here are identified by Subject
+// CommonName, not SAN, and that is a legitimate, already-relied-upon
+// pattern, not a gap to close): when NEITHER leaf carries any SAN at
+// all, two empty sets would otherwise compare as "the same identity"
+// vacuously, with nothing actually compared. Falls back to comparing
+// Subject.CommonName in that specific case -- non-empty on both sides,
+// and equal -- which still correctly matches this project's own
+// SAN-less client certificates (same CommonName on both halves of a
+// legitimately-issued pair) while correctly rejecting an adversary who
+// pairs two unrelated, equally SAN-less certificates (different
+// CommonNames, or either one blank).
+func sameDualIdentity(classicalLeaf, pqLeaf *x509.Certificate) bool {
+	if !leafHasAnySAN(classicalLeaf) && !leafHasAnySAN(pqLeaf) {
+		return classicalLeaf.Subject.CommonName != "" &&
+			classicalLeaf.Subject.CommonName == pqLeaf.Subject.CommonName
+	}
+	sameSet := func(a, b []string) bool {
+		if len(a) != len(b) {
+			return false
+		}
+		as, bs := slices.Clone(a), slices.Clone(b)
+		slices.Sort(as)
+		slices.Sort(bs)
+		return slices.Equal(as, bs)
+	}
+	if !sameSet(classicalLeaf.DNSNames, pqLeaf.DNSNames) {
+		return false
+	}
+	if !sameSet(classicalLeaf.EmailAddresses, pqLeaf.EmailAddresses) {
+		return false
+	}
+	if len(classicalLeaf.IPAddresses) != len(pqLeaf.IPAddresses) {
+		return false
+	}
+	aIPs := make([]string, len(classicalLeaf.IPAddresses))
+	for i, ip := range classicalLeaf.IPAddresses {
+		aIPs[i] = ip.String()
+	}
+	bIPs := make([]string, len(pqLeaf.IPAddresses))
+	for i, ip := range pqLeaf.IPAddresses {
+		bIPs[i] = ip.String()
+	}
+	if !sameSet(aIPs, bIPs) {
+		return false
+	}
+	if len(classicalLeaf.URIs) != len(pqLeaf.URIs) {
+		return false
+	}
+	aURIs := make([]string, len(classicalLeaf.URIs))
+	for i, u := range classicalLeaf.URIs {
+		aURIs[i] = u.String()
+	}
+	bURIs := make([]string, len(pqLeaf.URIs))
+	for i, u := range pqLeaf.URIs {
+		bURIs[i] = u.String()
+	}
+	return sameSet(aURIs, bURIs)
+}
diff --git a/dual_test.go b/dual_test.go
