+// --- session resumption. Known gap, explicitly tested and documented,
+// not left implicit: TLS 1.3 resumption skips Certificate/
+// CertificateVerify entirely, so a resumed connection would otherwise
+// inherit dual authentication from the original handshake without
+// re-verifying either chain. Decision taken: strict (Require=true)
+// connections never issue a session ticket at all (shouldSendSessionTickets
+// in handshake_server_tls13.go), so there is nothing to resume into.
+// Non-strict connections keep issuing tickets as before, but
+// DualAuthenticated is never restored from session state on resume --
+// confirmed directly below, not just asserted. ---
+
+func TestDualStrictModeDisablesSessionTickets(t *testing.T) {
+	pki := newDualTestPKI(t)
+	client, server := baseDualConfigs(pki)
+	serverPQ := pki.pqLeaf(dualTestServerName, x509.ExtKeyUsageServerAuth, []string{dualTestServerName})
+	server.Dual = &DualConfig{Certificates: []Certificate{serverPQ}, Require: true}
+	client.Dual = &DualConfig{RootCAs: pki.pqRootPool, Require: true}
+	client.ClientSessionCache = NewLRUClientSessionCache(4)
+
+	cc1, sc1, cerr1, serr1 := dualHandshakePipe(t, client, server)
+	defer cc1.Close()
+	defer sc1.Close()
+	if cerr1 != nil || serr1 != nil {
+		t.Fatalf("first (full) handshake failed: client=%v server=%v", cerr1, serr1)
+	}
+
+	cc2, sc2, cerr2, serr2 := dualHandshakePipe(t, client, server)
+	defer cc2.Close()
+	defer sc2.Close()
+	if cerr2 != nil || serr2 != nil {
+		t.Fatalf("second handshake failed: client=%v server=%v", cerr2, serr2)
+	}
+	if cc2.ConnectionState().DidResume {
+		t.Error("a second connection resumed a session from a STRICT dual server -- no ticket should ever have been issued to resume from")
+	}
+}
