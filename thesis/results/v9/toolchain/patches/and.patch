index 0000000..60858b2
--- /dev/null
+++ b/dual_test.go
@@ -0,0 +1,1092 @@
+// Copyright 2026 The MockOPIN project. Tests for dual.go (the AND
+// dual-certificate TLS 1.3 authentication mechanism), not part of the
+// upstream Go standard library test suite.
+package tls
+
+import (
+	"crypto/mldsa"
+	"crypto/rand"
+	"crypto/rsa"
+	"crypto/x509"
+	"crypto/x509/pkix"
+	"math/big"
+	"net"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+var dualTestSerial atomic.Int64
+
+func nextDualTestSerial() *big.Int {
+	return big.NewInt(dualTestSerial.Add(1))
+}
+
+// dualTestPKI generates a fresh, self-contained pair of root CAs for
+// each test -- one classical (RSA-2048), one post-quantum (ML-DSA-65,
+// genuinely self-signed, never classically signed) -- so every chain
+// built from it is, by construction, ML-DSA-only on the PQ side and
+// RSA-only on the classical side, matching the AND specification's own
+// category requirement.
+type dualTestPKI struct {
+	t testing.TB
+
+	classicalRootCert *x509.Certificate
+	classicalRootKey  *rsa.PrivateKey
+	pqRootCert        *x509.Certificate
+	pqRootKey         *mldsa.PrivateKey
+
+	classicalRootPool *x509.CertPool
+	pqRootPool        *x509.CertPool
+}
+
+func newDualTestPKI(t testing.TB) *dualTestPKI {
+	classicalRootKey, err := rsa.GenerateKey(rand.Reader, 2048)
+	if err != nil {
+		t.Fatal(err)
+	}
+	classicalRootTmpl := &x509.Certificate{
+		SerialNumber:          nextDualTestSerial(),
+		Subject:               pkix.Name{CommonName: "AND test classical root"},
+		NotBefore:              time.Now().Add(-time.Hour),
+		NotAfter:               time.Now().Add(24 * time.Hour),
+		IsCA:                   true,
+		BasicConstraintsValid:  true,
+		KeyUsage:               x509.KeyUsageCertSign | x509.KeyUsageCRLSign,
+	}
+	classicalRootDER, err := x509.CreateCertificate(rand.Reader, classicalRootTmpl, classicalRootTmpl,
+		&classicalRootKey.PublicKey, classicalRootKey)
+	if err != nil {
+		t.Fatal(err)
+	}
+	classicalRootCert, err := x509.ParseCertificate(classicalRootDER)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	pqRootKey, err := mldsa.GenerateKey(mldsa.MLDSA65())
+	if err != nil {
+		t.Fatal(err)
+	}
+	pqRootTmpl := &x509.Certificate{
+		SerialNumber:          nextDualTestSerial(),
+		Subject:               pkix.Name{CommonName: "AND test post-quantum root"},
+		NotBefore:             time.Now().Add(-time.Hour),
+		NotAfter:              time.Now().Add(24 * time.Hour),
+		IsCA:                  true,
+		BasicConstraintsValid: true,
+		KeyUsage:              x509.KeyUsageCertSign | x509.KeyUsageCRLSign,
+	}
+	pqRootDER, err := x509.CreateCertificate(rand.Reader, pqRootTmpl, pqRootTmpl, pqRootKey.PublicKey(), pqRootKey)
+	if err != nil {
+		t.Fatal(err)
+	}
+	pqRootCert, err := x509.ParseCertificate(pqRootDER)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	classicalRootPool := x509.NewCertPool()
+	classicalRootPool.AddCert(classicalRootCert)
+	pqRootPool := x509.NewCertPool()
+	pqRootPool.AddCert(pqRootCert)
+
+	return &dualTestPKI{
+		t: t,
+
+		classicalRootCert: classicalRootCert,
+		classicalRootKey:  classicalRootKey,
+		pqRootCert:        pqRootCert,
+		pqRootKey:         pqRootKey,
+
+		classicalRootPool: classicalRootPool,
+		pqRootPool:        pqRootPool,
+	}
+}
+
+func (p *dualTestPKI) classicalLeaf(cn string, eku x509.ExtKeyUsage, dnsNames []string) Certificate {
+	key, err := rsa.GenerateKey(rand.Reader, 2048)
+	if err != nil {
+		p.t.Fatal(err)
+	}
+	tmpl := &x509.Certificate{
+		SerialNumber: nextDualTestSerial(),
+		Subject:      pkix.Name{CommonName: cn},
+		NotBefore:    time.Now().Add(-time.Hour),
+		NotAfter:     time.Now().Add(24 * time.Hour),
+		KeyUsage:     x509.KeyUsageDigitalSignature,
+		ExtKeyUsage:  []x509.ExtKeyUsage{eku},
+		DNSNames:     dnsNames,
+	}
+	der, err := x509.CreateCertificate(rand.Reader, tmpl, p.classicalRootCert, &key.PublicKey, p.classicalRootKey)
+	if err != nil {
+		p.t.Fatal(err)
+	}
+	return Certificate{Certificate: [][]byte{der}, PrivateKey: key}
+}
+
+// pqLeafWithKey mints a post-quantum leaf whose CERTIFICATE advertises
+// pubKey (the real, legitimately-issued key), but whose returned
+// PrivateKey is signKey -- which may deliberately NOT match pubKey, to
+// simulate an adversary who holds the certificate's own public bytes
+// (always observable on the wire) but not its private key.
+func (p *dualTestPKI) pqLeafWithKey(cn string, eku x509.ExtKeyUsage, dnsNames []string, pubKey *mldsa.PublicKey, signKey *mldsa.PrivateKey) Certificate {
+	tmpl := &x509.Certificate{
+		SerialNumber: nextDualTestSerial(),
+		Subject:      pkix.Name{CommonName: cn},
+		NotBefore:    time.Now().Add(-time.Hour),
+		NotAfter:     time.Now().Add(24 * time.Hour),
+		KeyUsage:     x509.KeyUsageDigitalSignature,
+		ExtKeyUsage:  []x509.ExtKeyUsage{eku},
+		DNSNames:     dnsNames,
+	}
+	der, err := x509.CreateCertificate(rand.Reader, tmpl, p.pqRootCert, pubKey, p.pqRootKey)
+	if err != nil {
+		p.t.Fatal(err)
+	}
+	return Certificate{Certificate: [][]byte{der}, PrivateKey: signKey}
+}
+
+func (p *dualTestPKI) pqLeaf(cn string, eku x509.ExtKeyUsage, dnsNames []string) Certificate {
+	key, err := mldsa.GenerateKey(mldsa.MLDSA65())
+	if err != nil {
+		p.t.Fatal(err)
+	}
+	return p.pqLeafWithKey(cn, eku, dnsNames, key.PublicKey(), key)
+}
