+// --- 18: wire size measurement -- real numbers for the thesis, not
+// just pass/fail. ---
+
+func TestDualWireSizeMeasurement(t *testing.T) {
+	pki := newDualTestPKI(t)
+	classical := pki.classicalLeaf(dualTestServerName, x509.ExtKeyUsageServerAuth, []string{dualTestServerName})
+	pq := pki.pqLeaf(dualTestServerName, x509.ExtKeyUsageServerAuth, []string{dualTestServerName})
+
+	plainMsg := &certificateMsgTLS13{certificate: classical}
+	plainBytes, err := plainMsg.marshal()
+	if err != nil {
+		t.Fatal(err)
+	}
+	dualMsg := &certificateMsgTLS13{certificate: classical, dualPQCertificate: pq.Certificate}
+	dualBytes, err := dualMsg.marshal()
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	rsaSig := make([]byte, 256)   // RSA-2048 PSS signature size
+	mldsaSig := make([]byte, 3309) // ML-DSA-65 signature size
+	plainVerifyLen := len(rsaSig)
+	dualVerifyLen := len(marshalDualSignature(rsaSig, mldsaSig))
+
+	t.Logf("Certificate message: classical-only %d bytes, dual (classical+ML-DSA-65) %d bytes (+%d, +%.1f%%)",
+		len(plainBytes), len(dualBytes), len(dualBytes)-len(plainBytes),
+		100*float64(len(dualBytes)-len(plainBytes))/float64(len(plainBytes)))
+	t.Logf("CertificateVerify signature field: classical-only %d bytes, dual %d bytes (+%d, +%.1f%%)",
+		plainVerifyLen, dualVerifyLen, dualVerifyLen-plainVerifyLen,
+		100*float64(dualVerifyLen-plainVerifyLen)/float64(plainVerifyLen))
+	t.Logf("post-quantum certificate chain alone: %d bytes", len(pq.Certificate[0]))
+
+	if len(dualBytes) <= len(plainBytes) {
+		t.Error("dual Certificate message is not larger than the classical-only one")
+	}
+	if dualVerifyLen <= plainVerifyLen {
+		t.Error("dual CertificateVerify signature is not larger than the classical-only one")
+	}
+}
