# v9, Fase 1, T5: gateway (fork of mock_mtls) built against the patched
# go1.27.3 toolchain (AND dual-certificate mechanism) instead of
# mock_mtls's own golang:1.27-rc base. The toolchain image must be built
# and tagged mockopin-v9-toolchain first -- see ../Makefile's `toolchain`
# target, which builds it from ../../toolchain/Dockerfile unchanged.
FROM mockopin-v9-toolchain AS goroot

FROM alpine:3.24@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a AS build
COPY --from=goroot /go-src /usr/local/go
ENV PATH="/usr/local/go/bin:${PATH}"
WORKDIR /app
COPY go.mod ./
COPY *.go ./
RUN CGO_ENABLED=0 GOOS=linux go build -o /gateway

FROM alpine:3.24@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a
# certs/: populated by ../Makefile before this build from thesis/results/
# v9/certs/generated/ (never a bind mount -- see thesis/results/v9/
# DECISIONS.md, Decisao 11, on why bind mounts are avoided entirely in
# this environment). Ephemeral, gitignored, regenerated by `make certs`
# every run.
COPY --from=build /gateway /gateway
COPY certs /certs
EXPOSE 443
ENTRYPOINT ["/gateway"]
